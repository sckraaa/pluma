# Secrets for docker-compose.yaml and docker-compose-env.yaml (also read by
# teamgramd/etc configs as ${NAME}). Setup: docs/ops/security-setup.md.
#
#   cp .env.example .env && chmod 600 .env
#
# Fill every empty value: compose refuses to start while one is missing.
# Generate passwords with `openssl rand -hex 24` (hex only: values are put
# into YAML and DSN strings verbatim). Never commit .env.

# ---------- Server (docs/ops/deployment.md) ----------
# The images CI built for the commit the server runs (workflow images):
#   TEAMGRAM_IMAGE=ghcr.io/sckraaa/pluma-server:<commit>
#   PLUMA_ALERTPUSH_IMAGE=ghcr.io/sckraaa/pluma-alertpush:<commit>
#   PLUMA_BACKUP_IMAGE=ghcr.io/sckraaa/pluma-backup:<commit>
# Unset, compose builds them locally (a development machine).
TEAMGRAM_IMAGE=
PLUMA_ALERTPUSH_IMAGE=
PLUMA_BACKUP_IMAGE=
# The IPv4 address of Pluma when the server has more than one: the gateway
# listens there only and all outgoing traffic leaves from it, with
# docker-compose.public-ip.yaml. Empty: every address, primary outgoing.
PLUMA_PUBLIC_IPV4=
# The web client, with docker-compose.web.yaml: the image of its site
# (ghcr.io/sckraaa/pluma-web:<commit of pluma-web>), its name and the other
# names of the site, which lead to it (comma-separated). Their DNS A records
# point at the address of Pluma.
PLUMA_WEB_IMAGE=
PLUMA_WEB_DOMAIN=
PLUMA_SITE_DOMAINS=
# ---------- MySQL ----------
# root: administration only; applied on the first start (empty ./data/mysql).
MYSQL_ROOT_PASSWORD=
# Password of the "teamgram" user the services connect as.
MYSQL_PASSWORD=

# ---------- Redis ----------
# requirepass; every service passes it in its Redis config.
REDIS_PASSWORD=

# ---------- Object storage: Garage (ADR 0014) ----------
# S3 key of dfs, in Garage's format:
#   S3_ACCESS_KEY_ID:     echo GK$(openssl rand -hex 12)
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Secrets of the Garage node: openssl rand -hex 32 each.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------- Login codes ----------
# Key of the HMAC-SHA256 under which login codes are stored in Redis (bff and
# tools/pluma-admin). At least 32 characters: openssl rand -hex 32
# Changing it only invalidates codes not yet used.
LOGIN_CODE_HMAC_KEY=

# ---------- Auth keys at rest ----------
# Key of the AES-256-GCM under which authsession stores the MTProto auth keys
# (auth_keys.body and the Redis cache): the hex of 32 random bytes,
# openssl rand -hex 32. Keep it outside the database and its backups: with
# a dump and this key the traffic of every client can be decrypted, and
# without it a restored database cannot be used (every client signs in
# again). Never change it on a running installation.
AUTH_KEY_ENCRYPTION_KEY=

# ---------- Push devices ----------
# Key of the AES-256-GCM under which bff and push store the secrets of push
# devices (push_devices.secret, the keys their notifications are encrypted
# with): openssl rand -hex 32. Separate from AUTH_KEY_ENCRYPTION_KEY so that
# bff cannot open the auth keys. Changing it makes the stored devices
# unusable until the clients register again (within a day).
PUSH_SECRET_ENCRYPTION_KEY=

# ---------- Push providers (docs/ops/push.md) ----------
# Apple: Key ID of the APNs key (.p8) and the Team ID of the developer
# account; the key file itself is mounted into the push service only.
APNS_KEY_ID=
APNS_TEAM_ID=
# Host paths of the key files (mode 0600, outside git): the APNs .p8 and the
# JSON key of the FCM service account (role Firebase Cloud Messaging API
# Admin). An empty file turns that provider off.
APNS_KEY_FILE=./secrets/apns_key.p8
FCM_CREDENTIALS_FILE=./secrets/fcm_credentials.json

# ---------- MTProto server RSA key ----------
# Generated once: go run ./tools/genserverkey -out secrets/server_pkcs1.key
# Host path of the private key (mounted into the container as a secret).
SERVER_RSA_KEY_FILE=./secrets/server_pkcs1.key
# Fingerprint printed by genserverkey; gnetway refuses to start on a mismatch.
SERVER_RSA_KEY_FINGERPRINT=

# ---------- Alerts to the phone (ADR 0013, docs/ops/monitoring.md) ----------
# ntfy topic the phone subscribes to in the ntfy app. Anyone who knows the
# name can read it on a public server: make it random, openssl rand -hex 16
NTFY_TOPIC=
# ntfy server and an optional access token (self-hosted ntfy or a reserved
# topic on ntfy.sh).
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# Ping URL of the healthchecks.io check that pushes when the server stops
# reporting (https://hc-ping.com/<uuid>).
HEALTHCHECKS_PING_URL=

# ---------- Backups (docs/ops/backup.md) ----------
# restic repository in an S3-compatible store outside this server, e.g.
# Cloudflare R2: s3:https://<account id>.r2.cloudflarestorage.com/<bucket>
# Backblaze B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
# Encryption password of the repository. Without it no backup can be
# restored: keep a copy off this server (password manager).
RESTIC_PASSWORD=
# S3 API key with access to the bucket only.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# R2 uses "auto"; B2 its region, e.g. eu-central-003.
BACKUP_S3_REGION=auto
# Daily backup time, UTC.
BACKUP_AT=03:30
