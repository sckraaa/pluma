# Secrets for docker-compose.yaml and docker-compose-env.yaml (also read by
# teamgramd/etc configs as ${NAME}). Setup: docs/ops/security-setup.md.
#
#   cp .env.example .env && chmod 600 .env
#
# Fill every empty value: compose refuses to start while one is missing.
# Generate passwords with `openssl rand -hex 24` (hex only: values are put
# into YAML and DSN strings verbatim). Never commit .env.

# ---------- Server (docs/ops/deployment.md) ----------
# The images CI built for the commit the server runs (workflow images):
#   TEAMGRAM_IMAGE=ghcr.io/sckraaa/pluma-server:<commit>
#   PLUMA_ALERTPUSH_IMAGE=ghcr.io/sckraaa/pluma-alertpush:<commit>
#   PLUMA_BACKUP_IMAGE=ghcr.io/sckraaa/pluma-backup:<commit>
# Unset, compose builds them locally (a development machine).
TEAMGRAM_IMAGE=
PLUMA_ALERTPUSH_IMAGE=
PLUMA_BACKUP_IMAGE=
# The IPv4 address of Pluma when the server has more than one: the gateway
# listens there only and all outgoing traffic leaves from it, with
# docker-compose.public-ip.yaml. Empty: every address, primary outgoing.
PLUMA_PUBLIC_IPV4=
# On a server shared with other software: the systemd slice that caps all
# Pluma containers together (teamgramd/deploy/systemd/pluma.slice,
# docs/ops/memory.md). Empty: Docker's default; each container keeps its own
# limit either way.
PLUMA_CGROUP_PARENT=
# The web client, with docker-compose.web.yaml: the image of its site
# (ghcr.io/sckraaa/pluma-web:<commit of pluma-web>), its name and the other
# names of the site, which lead to it (separated by spaces, in quotes). Their DNS A records
# point at the address of Pluma.
PLUMA_WEB_IMAGE=
PLUMA_WEB_DOMAIN=
PLUMA_SITE_DOMAINS=
# The name of the provider of the login on sites (task 106); empty:
# oauth.pluma.chat.
PLUMA_OAUTH_DOMAIN=
# The iPhone app from the site, with docker-compose.iosinstall.yaml
# (docs/ops/ios-install.md): the image (ghcr.io/sckraaa/pluma-iosinstall:<commit>),
# the site's address, the App Store Connect key's id and issuer and the
# Apple Distribution certificate's id at Apple (none of them secret). The
# key, the certificate and the upload token are files in
# PLUMA_IOSINSTALL_SECRETS (default /opt/pluma/iosinstall), not here.
PLUMA_IOSINSTALL_IMAGE=
PLUMA_IOSINSTALL_URL=
PLUMA_ASC_KEY_ID=
PLUMA_ASC_ISSUER=
PLUMA_SIGN_CERTIFICATE_ID=
# The update of an installed build from the app itself (task 085): the
# secret of its update tickets, shared by bff and iosinstall
# (openssl rand -hex 32, at least 32 characters). It needs the releases
# service too. Empty: the app sends to the site's install page.
PLUMA_IOS_UPDATE_SECRET=
# The releases of the client apps, with docker-compose.releases.yaml
# (task 054, docs/ops/releases.md): the site they are served on at /dl/,
# the same as PLUMA_IOSINSTALL_URL. The upload token CI uses is a file in
# PLUMA_RELEASES_SECRETS (default /opt/pluma/releases), not here.
PLUMA_RELEASES_URL=

# ---------- Calls (task 068, docs/ops/calls.md) ----------
# STUN/TURN servers of one-to-one calls, comma separated:
# host:port:stun+turn. Empty: calls are off. coturn is not deployed yet.
# An entry with @<label> (host:port:stun+turn@ru) is signed with the secret
# of that label in CALLS_TURN_SECRETS instead of CALLS_TURN_SECRET (task
# 109: the TURN of the Russian node, docs/ops/calls.md, docs/ops/ru-node.md).
CALLS_ICE_SERVERS=
# static-auth-secret of coturn (openssl rand -hex 32); required with a turn entry.
CALLS_TURN_SECRET=
# The secrets of labelled TURN servers, <label>=<secret> comma separated:
# ru=<openssl rand -hex 32>; the same record (ru= alone) in /etc/pluma-ru/env
# of the node. A turn entry with a label needs its secret here, or bff does
# not start. Empty: no labelled entries.
CALLS_TURN_SECRETS=
# Quality parameters of a call (task 077, docs/ops/calls.md): empty or
# "pluma" for Pluma's values, "stock" for Telegram's, then key=value changes,
# for example: stock,audio_ptime_ms=20
CALLS_QUALITY=
# Public IPv4 of the TURN node (docker-compose.turn.yaml).
TURN_PUBLIC_IPV4=

# ---------- Group calls (task 093, docs/ops/group-calls.md) ----------
# host:port of the control API of the SFU node. docker-compose.sfu.yaml sets
# sfu:20500 for the node it runs; empty: group calls are off.
GROUPCALLS_SFU_ENDPOINT=
# The public IPv4 the clients reach the SFU at (docker-compose.sfu.yaml);
# Pluma's own address when it has one.
SFU_PUBLIC_IPV4=
# The published media ports: one UDP port for every client and the ICE-TCP
# port, the only way in where UDP is blocked (not 443, which is Caddy's).
SFU_UDP_PORT=20600
SFU_TCP_PORT=20601
# The limits of the SFU container, raised for more video at once.
SFU_MEMORY=512m
SFU_CPUS=2
# The SFU's image, of the commit that runs (CI: pluma-sfu); empty: built here
# from teamgramd/deploy/sfu/Dockerfile.
#PLUMA_SFU_IMAGE=ghcr.io/sckraaa/pluma-sfu:<commit>
# The control certificates (teamgramd/deploy/sfu/control-certs.sh) are in
# PLUMA_SFU_CERTS (default /opt/pluma/sfu) and PLUMA_GROUPCALLS_CERTS
# (default /opt/pluma/groupcalls), not here.

# ---------- HTTPS CDN of large files (task 107, ADR 0071, docs/ops/cdn.md) ----------
# Files of 1 MiB and more (documents and photos, never secret chats) go to
# patched clients through Gcore, which pulls their cipher from the origin in
# bff; the key, the IV and the hashes stay at home. Empty
# CDN_GCORE_BASE_URL: the CDN is off (no redirects, the origin does not
# listen). Empty values below take the defaults in brackets.
# https://<prefix>.gcorecdn.com of the Gcore CDN resource.
CDN_GCORE_BASE_URL=
# gcore-md5 (the Secure Token of the resource) or path-hmac when the Secure
# Token is unavailable [gcore-md5].
CDN_GCORE_SIGNER=
# The key the URLs are signed with: for gcore-md5 the Secure Token key of the
# resource, 6 to 32 characters (openssl rand -hex 16); for path-hmac 32 bytes
# in base64 (openssl rand -base64 32).
CDN_GCORE_TOKEN_KEY=
# The delivery leaves the routes for the rest of a calendar month (UTC) once
# this many GB (10^9 bytes) went through it [800].
CDN_GCORE_MONTHLY_GB=
# What Gcore sends to the origin in X-Pluma-Origin-Auth, set in the request
# headers of the resource: 64 hex digits (openssl rand -hex 32). Required
# with CDN_GCORE_BASE_URL.
CDN_ORIGIN_AUTH=
# The name Caddy publishes the origin on (an A record to the Pluma address);
# the Origin of the Gcore resource. Empty: Caddy does not serve it.
PLUMA_CDN_ORIGIN_DOMAIN=
# Where the origin listens in bff, the Docker network only [0.0.0.0:20480].
CDN_ORIGIN_LISTEN=
# Delivery 202 of the Russian node (task 109, docs/ops/ru-node.md): its
# nginx checks the same Secure Token as Gcore. Empty CDN_RU_BASE_URL: off.
# https://r1.<domain> of the node.
CDN_RU_BASE_URL=
# The key of its Secure Token, 6 to 32 characters (openssl rand -hex 16); the
# same in /etc/pluma-ru/env of the node.
CDN_RU_TOKEN_KEY=
# What the node sends to the origin in X-Pluma-Origin-Auth, its own value:
# 64 hex digits (openssl rand -hex 32), never CDN_ORIGIN_AUTH; the same in
# /etc/pluma-ru/env of the node. Required with CDN_RU_BASE_URL.
CDN_RU_ORIGIN_AUTH=
# Where its checks connect, through the tunnel [the host of CDN_RU_BASE_URL]:
# 10.78.0.1:443.
CDN_RU_HEALTH_ADDR=
# Its budget of a calendar month (UTC), GB [2000].
CDN_RU_MONTHLY_GB=
# The deliveries of the clients by the country of their address:
# "<countries or *>:<id>,...;..." with exactly one record "*" [*:201], e.g.
# RU,BY:202,201;*:201 with delivery 202.
CDN_ROUTES=
# How long a signed URL works, at most 24h [6h].
CDN_URL_TTL=
# The reads of files for their hashes, megabits a second [800].
CDN_PREPARE_RATE_MBIT=
# Files from this size go through the CDN, a multiple of 1 MiB [1048576].
CDN_MIN_FILE_SIZE=
# The kinds of files that go through the CDN: document, photo
# [document,photo]; the files of secret chats never do.
CDN_KINDS=
# How often each delivery is checked [1m], and how long a key whose client
# fell back from a delivery avoids it [1h].
CDN_HEALTH_EVERY=
CDN_AVOID_TTL=
# 1 lets a delivery have an http:// URL: the e2e stand only, never here.
CDN_DEV_ALLOW_HTTP=

# ---------- Voice transcription (task 090, docs/ops/transcription.md) ----------
# The speech engine: a service with POST /v1/audio/transcriptions of the
# OpenAI API. Ours is docker-compose.stt.yaml: http://stt:9379. Empty:
# transcription is off and the button answers with an error.
STT_URL=
# The name the engine knows its model by; required with STT_URL. The image
# built from teamgramd/deploy/stt/Dockerfile answers to gigaam-v3-e2e-rnnt.
# A text is stored under this name: after a change every record is
# transcribed again when somebody asks.
STT_MODEL=
# Bearer token of the engine (openssl rand -hex 32); bff sends it and the stt
# service requires it. Empty: no token.
STT_TOKEN=
# The language of the speech, for bff and the stt service alike. A Whisper
# model (ours or another engine) is told it; GigaAM hears Russian only and
# its stt service does not start with another language. Empty: the model's.
STT_LANGUAGE=
# How long the engine has for a record: <duration>+<factor>x, that much plus
# factor seconds for every second of sound. Empty: 30s+0.5x, for GigaAM on
# two CPUs; a slower engine gets more.
STT_TIMEOUT=
# The image of the stt service, of the commit that runs (CI: pluma-stt).
#PLUMA_STT_IMAGE=ghcr.io/sckraaa/pluma-stt:<commit>
# The limits of the stt container (docker-compose.stt.yaml): 768m and 2 CPUs
# for GigaAM, whatever the length of the records. A larger model needs more
# (Parakeet TDT v3: STT_MEMORY=2g); recount docs/ops/memory.md.
#STT_MEMORY=768m
#STT_CPUS=2
#STT_THREADS=2

# ---------- Translation of messages (task 101, docs/ops/translation.md) ----------
# The translation engine: a service with POST /v1/chat/completions of the
# OpenAI API. Ours is docker-compose.translate.yaml: http://translate:8080.
# Empty: the translation is off, and the clients offer no translation.
TRANSLATE_URL=
# The name the engine serves its model by; required with TRANSLATE_URL. A
# translation is cached under it: after a change every text is translated
# again when somebody asks.
TRANSLATE_MODEL=
# Bearer token of the engine, at least 32 characters (openssl rand -hex 32);
# bff sends it and the translate service requires it. Empty: no token.
TRANSLATE_TOKEN=
# The prompts and sampling of the model in bff. Empty: hy-mt1.5.
TRANSLATE_PROFILE=
# The image of the translate service, of the commit that runs (CI:
# pluma-translate).
#PLUMA_TRANSLATE_IMAGE=ghcr.io/sckraaa/pluma-translate:<commit>
# The limits and settings of the translate container
# (docker-compose.translate.yaml): Q8_0 with 4 slots of 4096 tokens holds
# about 2.9 GB whatever it translates; recount docs/ops/memory.md after a
# change.
#TRANSLATE_MEMORY=3584m
#TRANSLATE_CPUS=6
#TRANSLATE_THREADS=6
# The engine's slots (requests at once) and its context in tokens, shared
# evenly by the slots. Both bff and the translate container read them, so
# they always agree. Empty: 4 and 16384.
TRANSLATE_SLOTS=
TRANSLATE_CTX=

# ---------- MySQL ----------
# root: administration only; applied on the first start (empty ./data/mysql).
MYSQL_ROOT_PASSWORD=
# Password of the "teamgram" user the services connect as.
MYSQL_PASSWORD=

# ---------- Redis ----------
# requirepass; every service passes it in its Redis config.
REDIS_PASSWORD=

# ---------- Object storage: Garage (ADR 0014) ----------
# S3 key of dfs, in Garage's format:
#   S3_ACCESS_KEY_ID:     echo GK$(openssl rand -hex 12)
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Secrets of the Garage node: openssl rand -hex 32 each.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------- Login codes ----------
# Key of the HMAC-SHA256 under which login codes are stored in Redis (bff and
# tools/pluma-admin). At least 32 characters: openssl rand -hex 32
# Changing it only invalidates codes not yet used.
LOGIN_CODE_HMAC_KEY=
# One account with a fixed code, for the App Store reviewers, who can read
# neither the app nor pluma-admin: the phone as digits without '+' (put it on
# the allowlist too) and a code of 6 digits. Both empty: no such account.
LOGIN_REVIEW_PHONE=
LOGIN_REVIEW_CODE=

# ---------- Login codes from a Telegram account (docs/ops/login-codes.md) ----------
# Optional service docker-compose.codes.yaml. URL empty: bff does not use
# it, codes come in the app or from the administrator.
#   LOGIN_CODES_SENDER_URL=http://codes:9378
# Token of its internal API, shared by bff and the service, and the key that
# encrypts its TDLib database: openssl rand -hex 32 each.
LOGIN_CODES_SENDER_URL=
LOGIN_CODES_SENDER_TOKEN=
LOGIN_CODES_DB_KEY=

# ---------- Recovery email of the cloud password (task 091, docs/ops/email.md) ----------
# Resend API key with "Sending access" to the domain of MAIL_FROM only. Shown
# once by Resend: put it here and nowhere else. Empty: the recovery email is
# off (a forgotten password is reset after 7 days or by pluma-admin).
MAIL_API_KEY=
# The sender, on the domain verified in Resend; required with MAIL_API_KEY.
#   MAIL_FROM=Pluma <noreply@pluma.chat>
MAIL_FROM=

# ---------- Web files of inline bots (task 099, docs/ops/inline-bots.md) ----------
# Key that signs the addresses of the thumbnails inline bots name; the server
# fetches only what it signed (upload.getWebFile), so devices never reach a
# bot's host. At least 32 bytes: openssl rand -base64 32. Changing it breaks
# only the thumbnails of results already shown. Empty: the thumbnails go out
# unsigned and clients fetch them from the bot's host themselves.
WEBFILE_HMAC_KEY=

# ---------- Maps of geo points (task 100, docs/ops/maps.md) ----------
# The maps service (tileserver-gl) that renders the map previews of geo
# points for Android, Desktop and Web K: http://maps:8080 when its container
# runs (docker-compose.maps.yaml). Empty: maps are off, and a request for a
# map is refused. The coordinates never leave the server.
MAPS_URL=
# The styles of the service, one per language of the labels, comma
# separated. Empty: ru,en (other languages get English labels, the CIS
# languages Russian ones).
MAPS_STYLES=
# The longest render, and separately the longest wait for a free render
# slot, as a Go duration. Empty: 10s.
MAPS_TIMEOUT=
# How many maps one bff renders at once. Empty: 4.
MAPS_CONCURRENCY=
# How long a rendered map is kept in Redis, as a Go duration. Empty: 6h.
MAPS_CACHE_TTL=
# How many maps that are not in the cache one user may have rendered a
# minute; past it the client is told to wait. Empty: 60.
MAPS_PER_USER_PER_MINUTE=
# The image of the maps service and its data: the directory of the map file
# pluma.pmtiles (teamgramd/deploy/maps/extract.sh) and the limits of the
# container (docker-compose.maps.yaml); recount docs/ops/memory.md when they
# change.
#PLUMA_MAPS_IMAGE=pluma-maps:local
# With the maps overlay bff is on a second network and registers in etcd
# this fixed address of teamgram_net (POD_IP); change it only if another
# container holds it.
#PLUMA_BFF_IP=172.20.255.10
#MAPS_DATA_DIR=/opt/pluma-maps
#MAPS_MEMORY=2560m
#MAPS_CPUS=2
# The public map tiles of the clients' interactive maps (task 112,
# docs/ops/maps.md, "Публичная раздача"): the name Caddy serves them on (an
# A record to the Pluma address, as PLUMA_CDN_ORIGIN_DOMAIN) and the key in
# their paths, 32 characters of base64url
# (openssl rand -base64 24 | tr '+/' '-_'). Empty name: no such site. The
# key reaches every signed-in user through the app config; it keeps the
# home's channel from serving the tiles to anyone else.
PLUMA_MAPS_DOMAIN=
MAPS_PUBLIC_KEY=
# What bff hands the clients, https://<PLUMA_MAPS_DOMAIN>/<MAPS_PUBLIC_KEY>
# exactly, without a trailing slash; a wrong value stops bff. Empty: the
# clients get no map (Desktop shows no location item, Android no map).
MAPS_PUBLIC_URL=
# The limits of the maps-tiles container (docker-compose.maps.yaml).
#MAPS_TILES_MEMORY=512m
#MAPS_TILES_CPUS=1

# ---------- Edges of the clients and the Russian node (task 109, ADR 0072) ----------
# MTProto in a WebSocket through the CDN (Gcore) or the Russian node amf, for
# patched clients whose direct address is blocked (docs/ops/edge.md); the
# node itself: docs/ops/ru-node.md. Every value empty: no edge, as before.
# The name the second Gcore resource pulls (an A record to the Pluma
# address, as PLUMA_CDN_ORIGIN_DOMAIN) and the X-Pluma-Edge-Auth value it
# adds, 64 hex digits (openssl rand -hex 32), never CDN_ORIGIN_AUTH; empty
# name: no such site.
PLUMA_EDGE_ORIGIN_DOMAIN=
PLUMA_EDGE_ORIGIN_AUTH=
# The name of the Russian node's edge (ru.pluma.chat); empty: no such site.
# Its port 8443 exists only with docker-compose.ru.yaml.
PLUMA_RU_EDGE_DOMAIN=
# Home's address in the tunnel to the Russian node (tunnel.sh --link ru,
# docs/ops/home-server.md): 10.78.0.2. docker-compose.ru.yaml publishes
# Caddy's 80, 443 and 8443 there and refuses to start without it; the
# interface plumaru must be up before Docker.
PLUMA_RU_TUNNEL_IPV4=
# What bff hands the clients in pluma_edge: the edges by name,
# "gcore=wss://<prefix2>.gcorecdn.com/apiws,ru=wss://ru.pluma.chat/apiws";
# empty: no pluma_edge, the clients keep the list built into them. The
# edges and their order by the country of the client,
# "<countries or *>:<direct,edge or edge,direct>:<edges>" separated by ";"
# [*:direct,edge:<every edge>], e.g.
# RU,BY:edge,direct:ru,gcore;*:direct,edge:gcore,ru; how many seconds a
# client keeps to an edge it switched to, 60-86400 [1800]. A wrong value
# stops bff.
EDGE_WS_URLS=
EDGE_ROUTES=
EDGE_STICKY_S=
# The path probes of the patched clients (task 113, ADR 0073,
# docs/ops/edge.md): what bff hands them in pluma_probe, with the country of
# the client. Each empty one takes the default of the brief [in brackets];
# a value out of its range stops bff. The probe that admits a path asks for
# GATE_DOWN bytes [65536], 16384-524288; the background one RANK_DOWN
# [196608], same range; both send UP bytes [20480], 0-65536. A path that
# stops for STALL_MS [1500], 300-10000, is frozen; DEADLINE_MS [6000],
# 1000-30000, longer than STALL_MS, ends a probe; a request without a byte
# for SUSPECT_MS [4000], 1000-30000, makes a probe at once. Background
# probes every REPROBE_S [21600], 600-604800, and at a start no sooner than
# RANK_MIN_INTERVAL_S [1800], 60-86400, after the last. A switch waits
# MIN_DWELL_S [600], 0-86400, since the last; SWITCH_RATIO [0.7] switches
# on two probes CONFIRM_S [60], 10-3600, apart, SWITCH_RATIO_NOW [0.25] on
# one, both 0.05-0.95, the second below the first. The edges are probed in
# the background when the direct path scores worse than
# EDGE_PROBE_IF_DIRECT_MS [1500], 100-60000. A frozen path is left out for
# BAD_TTL_S [86400], 60-604800, a failed one for FAILED_TTL_S [300],
# 10-86400; the other paths start RACE_STAGGER_MS [800], 0-10000, after
# the first.
PATH_PROBE_GATE_DOWN=
PATH_PROBE_RANK_DOWN=
PATH_PROBE_UP=
PATH_PROBE_STALL_MS=
PATH_PROBE_DEADLINE_MS=
PATH_PROBE_SUSPECT_MS=
PATH_PROBE_REPROBE_S=
PATH_PROBE_RANK_MIN_INTERVAL_S=
PATH_PROBE_MIN_DWELL_S=
PATH_PROBE_SWITCH_RATIO=
PATH_PROBE_SWITCH_RATIO_NOW=
PATH_PROBE_EDGE_PROBE_IF_DIRECT_MS=
PATH_PROBE_BAD_TTL_S=
PATH_PROBE_FAILED_TTL_S=
PATH_PROBE_RACE_STAGGER_MS=
PATH_PROBE_CONFIRM_S=

# ---------- Bot platform (task 106, docs/ops/bots.md) ----------
# Key of the AES-256-GCM under which bff and pluma-admin store the keys of
# bots derived from their tokens (bot_secret_keys: the key of the initData
# of mini apps and of the data of a login on a bot's site): openssl rand
# -hex 32. Empty: no keys are stored, and the mini apps and the login of
# bots are off. Losing it: every bot must log in again or get a new token
# (pluma-admin bot token), which stores the keys again.
BOT_SECRET_ENCRYPTION_KEY=
# Ed25519 seed (hex) of the signature of the initData of mini apps, which
# third parties check with the server's public key: openssl rand -hex 32.
# Changing it invalidates the signatures of the mini apps open at the time.
# Empty: no mini app opens.
WEBAPP_SIGNING_KEY=
# The RSA keys (PEM) of the ID tokens of oauth.pluma.chat, the login of
# users on sites (task 106): openssl genpkey -algorithm RSA -pkeyopt
# rsa_keygen_bits:2048 -out secrets/oauth_signing_key.pem (mode 0600). The
# first key signs; to replace it, put the new one second for a day, then
# first, then drop the old one (docs/ops/bots.md). An empty file turns the
# provider off; the file must exist.
OAUTH_SIGNING_KEY_FILE=./secrets/oauth_signing_key.pem

# ---------- Statistics of channels and groups (task 103, docs/ops/stats.md) ----------
# Key of the HMAC-SHA256 that signs the zoom tokens of the graphs of the
# statistics (a day zoomed into its hours): 32 random bytes in base64,
# openssl rand -base64 32. Empty: the statistics are off, stats.* answer
# ERR_ENTERPRISE_IS_BLOCKED and the clients do not offer them in channels
# and groups. Changing it invalidates the zoom tokens given out; the
# clients ask for the statistics again.
STATS_GRAPH_TOKEN_KEY=

# ---------- Built-in inline bots (task 099, docs/ops/inline-bots.md) ----------
# The SearXNG @pic searches pictures with: http://searxng:8080 when its
# container runs (docker-compose.search.yaml). Empty: @pic answers with empty
# lists.
SEARXNG_URL=
# The secret of SearXNG itself (its server.secret_key): needed only with
# docker-compose.search.yaml, which does not start without it.
# openssl rand -hex 32
SEARXNG_SECRET=
# The limits of the searxng container (docker-compose.search.yaml); recount
# docs/ops/memory.md when they change.
#SEARXNG_MEMORY=512m
#SEARXNG_CPUS=1
# The app key of KLIPY (partner.klipy.com, API Keys) @gif searches GIFs with
# (docs/ops/inline-bots.md, "KLIPY"). The server asks KLIPY and imports the
# GIFs into dfs; no device reaches KLIPY. Empty: @gif has the GIFs popular
# within the server and no search by text.
KLIPY_API_KEY=
# The bytes of media @gif and @pic may import into dfs in a UTC day; past it
# only media imported before are shown. Empty: 1073741824 (1 GiB).
INLINE_IMPORT_DAILY_BYTES=

# ---------- Auth keys at rest ----------
# Key of the AES-256-GCM under which authsession stores the MTProto auth keys
# (auth_keys.body and the Redis cache): the hex of 32 random bytes,
# openssl rand -hex 32. Keep it outside the database and its backups: with
# a dump and this key the traffic of every client can be decrypted, and
# without it a restored database cannot be used (every client signs in
# again). Never change it on a running installation.
AUTH_KEY_ENCRYPTION_KEY=

# ---------- Push devices ----------
# Key of the AES-256-GCM under which bff and push store the secrets of push
# devices (push_devices.secret, the keys their notifications are encrypted
# with): openssl rand -hex 32. Separate from AUTH_KEY_ENCRYPTION_KEY so that
# bff cannot open the auth keys. Changing it makes the stored devices
# unusable until the clients register again (within a day).
PUSH_SECRET_ENCRYPTION_KEY=

# ---------- Push providers (docs/ops/push.md) ----------
# Apple: Key ID of the APNs key (.p8) and the Team ID of the developer
# account; the key file itself is mounted into the push service only.
APNS_KEY_ID=
APNS_TEAM_ID=
# Host paths of the key files (mode 0600, outside git): the APNs .p8 and the
# JSON key of the FCM service account (role Firebase Cloud Messaging API
# Admin). An empty file turns that provider off.
APNS_KEY_FILE=./secrets/apns_key.p8
FCM_CREDENTIALS_FILE=./secrets/fcm_credentials.json

# ---------- MTProto server RSA key ----------
# Generated once: go run ./tools/genserverkey -out secrets/server_pkcs1.key
# Host path of the private key (mounted into the container as a secret).
SERVER_RSA_KEY_FILE=./secrets/server_pkcs1.key
# Fingerprint printed by genserverkey; gnetway refuses to start on a mismatch.
SERVER_RSA_KEY_FINGERPRINT=

# ---------- Alerts to the phone (ADR 0013, docs/ops/monitoring.md) ----------
# ntfy topic the phone subscribes to in the ntfy app. Anyone who knows the
# name can read it on a public server: make it random, openssl rand -hex 16
NTFY_TOPIC=
# ntfy server and an optional access token (self-hosted ntfy or a reserved
# topic on ntfy.sh).
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# Ping URL of the healthchecks.io check that pushes when the server stops
# reporting (https://hc-ping.com/<uuid>).
HEALTHCHECKS_PING_URL=

# ---------- Backups (docs/ops/backup.md) ----------
# restic repository in an S3-compatible store outside this server, e.g.
# Cloudflare R2: s3:https://<account id>.r2.cloudflarestorage.com/<bucket>
# Backblaze B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
# Encryption password of the repository. Without it no backup can be
# restored: keep a copy off this server (password manager).
RESTIC_PASSWORD=
# S3 API key with access to the bucket only.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# R2 uses "auto"; B2 its region, e.g. eu-central-003.
BACKUP_S3_REGION=auto
# Daily backup time, UTC.
BACKUP_AT=03:30

# ---------- GeoIP (docs/ops/deployment.md, "GeoIP") ----------
# MaxMind account ID and license key of the owner's free GeoLite account
# (maxmind.com, Account > Manage License Keys). The geoipupdate service
# downloads GeoLite City with them; the key is a secret.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ---------- Language packs (docs/ops/langpacks.md) ----------
# api_id of the owner's application (my.telegram.org, a number): only
# "pluma-admin langpack fetch" uses it, to read Telegram's language packs
# without a login. No api_hash is needed. Empty: fetch stops with an error
# and the stored packs stay as they are.
TELEGRAM_API_ID=

# ---------- Sticker sets from Telegram on demand (task 030, docs/ops/catalog.md) ----------
# The bot (@BotFather) the server reads a sticker or emoji set from Telegram
# with when a user opens one it lacks (t.me/addstickers/<name>), and the
# api_hash of the application of TELEGRAM_API_ID. All empty: no bot, and
# such a set is "not found".
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# The moderation panel (docker-compose.admin.yaml, docs/ops/admin-panel.md):
# its https address in the tailnet, and the password of its database user.
PANEL_ORIGIN=
ADMIN_MYSQL_PASSWORD=
# The panel's link to Grafana, and the token of the admin routes of the releases
# service (openssl rand -hex 32). Empty: no link, the Releases page is off.
PANEL_GRAFANA_URL=
RELEASES_ADMIN_TOKEN=
