# Secrets for docker-compose.yaml and docker-compose-env.yaml (also read by
# teamgramd/etc configs as ${NAME}). Setup: docs/ops/security-setup.md.
#
#   cp .env.example .env && chmod 600 .env
#
# Fill every empty value: compose refuses to start while one is missing.
# Generate passwords with `openssl rand -hex 24` (hex only: values are put
# into YAML and DSN strings verbatim). Never commit .env.

# ---------- Server (docs/ops/deployment.md) ----------
# The images CI built for the commit the server runs (workflow images):
#   TEAMGRAM_IMAGE=ghcr.io/sckraaa/pluma-server:<commit>
#   PLUMA_ALERTPUSH_IMAGE=ghcr.io/sckraaa/pluma-alertpush:<commit>
#   PLUMA_BACKUP_IMAGE=ghcr.io/sckraaa/pluma-backup:<commit>
# Unset, compose builds them locally (a development machine).
TEAMGRAM_IMAGE=
PLUMA_ALERTPUSH_IMAGE=
PLUMA_BACKUP_IMAGE=
# The IPv4 address of Pluma when the server has more than one: the gateway
# listens there only and all outgoing traffic leaves from it, with
# docker-compose.public-ip.yaml. Empty: every address, primary outgoing.
PLUMA_PUBLIC_IPV4=
# On a server shared with other software: the systemd slice that caps all
# Pluma containers together (teamgramd/deploy/systemd/pluma.slice,
# docs/ops/memory.md). Empty: Docker's default; each container keeps its own
# limit either way.
PLUMA_CGROUP_PARENT=
# The web client, with docker-compose.web.yaml: the image of its site
# (ghcr.io/sckraaa/pluma-web:<commit of pluma-web>), its name and the other
# names of the site, which lead to it (separated by spaces, in quotes). Their DNS A records
# point at the address of Pluma.
PLUMA_WEB_IMAGE=
PLUMA_WEB_DOMAIN=
PLUMA_SITE_DOMAINS=
# The iPhone app from the site, with docker-compose.iosinstall.yaml
# (docs/ops/ios-install.md): the image (ghcr.io/sckraaa/pluma-iosinstall:<commit>),
# the site's address, the App Store Connect key's id and issuer and the
# Apple Distribution certificate's id at Apple (none of them secret). The
# key, the certificate and the upload token are files in
# PLUMA_IOSINSTALL_SECRETS (default /opt/pluma/iosinstall), not here.
PLUMA_IOSINSTALL_IMAGE=
PLUMA_IOSINSTALL_URL=
PLUMA_ASC_KEY_ID=
PLUMA_ASC_ISSUER=
PLUMA_SIGN_CERTIFICATE_ID=
# The update of an installed build from the app itself (task 085): the
# secret of its update tickets, shared by bff and iosinstall
# (openssl rand -hex 32, at least 32 characters). It needs the releases
# service too. Empty: the app sends to the site's install page.
PLUMA_IOS_UPDATE_SECRET=
# The releases of the client apps, with docker-compose.releases.yaml
# (task 054, docs/ops/releases.md): the site they are served on at /dl/,
# the same as PLUMA_IOSINSTALL_URL. The upload token CI uses is a file in
# PLUMA_RELEASES_SECRETS (default /opt/pluma/releases), not here.
PLUMA_RELEASES_URL=

# ---------- Calls (task 068, docs/ops/calls.md) ----------
# STUN/TURN servers of one-to-one calls, comma separated:
# host:port:stun+turn. Empty: calls are off. coturn is not deployed yet.
CALLS_ICE_SERVERS=
# static-auth-secret of coturn (openssl rand -hex 32); required with a turn entry.
CALLS_TURN_SECRET=
# Quality parameters of a call (task 077, docs/ops/calls.md): empty or
# "pluma" for Pluma's values, "stock" for Telegram's, then key=value changes,
# for example: stock,audio_ptime_ms=20
CALLS_QUALITY=
# Public IPv4 of the TURN node (docker-compose.turn.yaml).
TURN_PUBLIC_IPV4=

# ---------- Voice transcription (task 090, docs/ops/transcription.md) ----------
# The speech engine: a service with POST /v1/audio/transcriptions of the
# OpenAI API. Ours is docker-compose.stt.yaml: http://stt:9379. Empty:
# transcription is off and the button answers with an error.
STT_URL=
# The name the engine knows its model by; required with STT_URL. The image
# built from teamgramd/deploy/stt/Dockerfile answers to gigaam-v3-e2e-rnnt.
# A text is stored under this name: after a change every record is
# transcribed again when somebody asks.
STT_MODEL=
# Bearer token of the engine (openssl rand -hex 32); bff sends it and the stt
# service requires it. Empty: no token.
STT_TOKEN=
# The language of the speech, for bff and the stt service alike. A Whisper
# model (ours or another engine) is told it; GigaAM hears Russian only and
# its stt service does not start with another language. Empty: the model's.
STT_LANGUAGE=
# How long the engine has for a record: <duration>+<factor>x, that much plus
# factor seconds for every second of sound. Empty: 30s+0.5x, for GigaAM on
# two CPUs; a slower engine gets more.
STT_TIMEOUT=
# The image of the stt service, of the commit that runs (CI: pluma-stt).
#PLUMA_STT_IMAGE=ghcr.io/sckraaa/pluma-stt:<commit>
# The limits of the stt container (docker-compose.stt.yaml): 768m and 2 CPUs
# for GigaAM, whatever the length of the records. A larger model needs more
# (Parakeet TDT v3: STT_MEMORY=2g); recount docs/ops/memory.md.
#STT_MEMORY=768m
#STT_CPUS=2
#STT_THREADS=2

# ---------- MySQL ----------
# root: administration only; applied on the first start (empty ./data/mysql).
MYSQL_ROOT_PASSWORD=
# Password of the "teamgram" user the services connect as.
MYSQL_PASSWORD=

# ---------- Redis ----------
# requirepass; every service passes it in its Redis config.
REDIS_PASSWORD=

# ---------- Object storage: Garage (ADR 0014) ----------
# S3 key of dfs, in Garage's format:
#   S3_ACCESS_KEY_ID:     echo GK$(openssl rand -hex 12)
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Secrets of the Garage node: openssl rand -hex 32 each.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------- Login codes ----------
# Key of the HMAC-SHA256 under which login codes are stored in Redis (bff and
# tools/pluma-admin). At least 32 characters: openssl rand -hex 32
# Changing it only invalidates codes not yet used.
LOGIN_CODE_HMAC_KEY=
# One account with a fixed code, for the App Store reviewers, who can read
# neither the app nor pluma-admin: the phone as digits without '+' (put it on
# the allowlist too) and a code of 6 digits. Both empty: no such account.
LOGIN_REVIEW_PHONE=
LOGIN_REVIEW_CODE=

# ---------- Login codes from a Telegram account (docs/ops/login-codes.md) ----------
# Optional service docker-compose.codes.yaml. URL empty: bff does not use
# it, codes come in the app or from the administrator.
#   LOGIN_CODES_SENDER_URL=http://codes:9378
# Token of its internal API, shared by bff and the service, and the key that
# encrypts its TDLib database: openssl rand -hex 32 each.
LOGIN_CODES_SENDER_URL=
LOGIN_CODES_SENDER_TOKEN=
LOGIN_CODES_DB_KEY=

# ---------- Auth keys at rest ----------
# Key of the AES-256-GCM under which authsession stores the MTProto auth keys
# (auth_keys.body and the Redis cache): the hex of 32 random bytes,
# openssl rand -hex 32. Keep it outside the database and its backups: with
# a dump and this key the traffic of every client can be decrypted, and
# without it a restored database cannot be used (every client signs in
# again). Never change it on a running installation.
AUTH_KEY_ENCRYPTION_KEY=

# ---------- Push devices ----------
# Key of the AES-256-GCM under which bff and push store the secrets of push
# devices (push_devices.secret, the keys their notifications are encrypted
# with): openssl rand -hex 32. Separate from AUTH_KEY_ENCRYPTION_KEY so that
# bff cannot open the auth keys. Changing it makes the stored devices
# unusable until the clients register again (within a day).
PUSH_SECRET_ENCRYPTION_KEY=

# ---------- Push providers (docs/ops/push.md) ----------
# Apple: Key ID of the APNs key (.p8) and the Team ID of the developer
# account; the key file itself is mounted into the push service only.
APNS_KEY_ID=
APNS_TEAM_ID=
# Host paths of the key files (mode 0600, outside git): the APNs .p8 and the
# JSON key of the FCM service account (role Firebase Cloud Messaging API
# Admin). An empty file turns that provider off.
APNS_KEY_FILE=./secrets/apns_key.p8
FCM_CREDENTIALS_FILE=./secrets/fcm_credentials.json

# ---------- MTProto server RSA key ----------
# Generated once: go run ./tools/genserverkey -out secrets/server_pkcs1.key
# Host path of the private key (mounted into the container as a secret).
SERVER_RSA_KEY_FILE=./secrets/server_pkcs1.key
# Fingerprint printed by genserverkey; gnetway refuses to start on a mismatch.
SERVER_RSA_KEY_FINGERPRINT=

# ---------- Alerts to the phone (ADR 0013, docs/ops/monitoring.md) ----------
# ntfy topic the phone subscribes to in the ntfy app. Anyone who knows the
# name can read it on a public server: make it random, openssl rand -hex 16
NTFY_TOPIC=
# ntfy server and an optional access token (self-hosted ntfy or a reserved
# topic on ntfy.sh).
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
# Ping URL of the healthchecks.io check that pushes when the server stops
# reporting (https://hc-ping.com/<uuid>).
HEALTHCHECKS_PING_URL=

# ---------- Backups (docs/ops/backup.md) ----------
# restic repository in an S3-compatible store outside this server, e.g.
# Cloudflare R2: s3:https://<account id>.r2.cloudflarestorage.com/<bucket>
# Backblaze B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>
RESTIC_REPOSITORY=
# Encryption password of the repository. Without it no backup can be
# restored: keep a copy off this server (password manager).
RESTIC_PASSWORD=
# S3 API key with access to the bucket only.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# R2 uses "auto"; B2 its region, e.g. eu-central-003.
BACKUP_S3_REGION=auto
# Daily backup time, UTC.
BACKUP_AT=03:30

# ---------- GeoIP (docs/ops/deployment.md, "GeoIP") ----------
# MaxMind account ID and license key of the owner's free GeoLite account
# (maxmind.com, Account > Manage License Keys). The geoipupdate service
# downloads GeoLite City with them; the key is a secret.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ---------- Language packs (docs/ops/langpacks.md) ----------
# api_id of the owner's application (my.telegram.org, a number): only
# "pluma-admin langpack fetch" uses it, to read Telegram's language packs
# without a login. No api_hash is needed. Empty: fetch stops with an error
# and the stored packs stay as they are.
TELEGRAM_API_ID=

# ---------- Sticker sets from Telegram on demand (task 030, docs/ops/catalog.md) ----------
# The bot (@BotFather) the server reads a sticker or emoji set from Telegram
# with when a user opens one it lacks (t.me/addstickers/<name>), and the
# api_hash of the application of TELEGRAM_API_ID. All empty: no bot, and
# such a set is "not found".
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=

# The moderation panel (docker-compose.admin.yaml, docs/ops/admin-panel.md):
# its https address in the tailnet, and the password of its database user.
PANEL_ORIGIN=
ADMIN_MYSQL_PASSWORD=
# The panel's link to Grafana, and the token of the admin routes of the releases
# service (openssl rand -hex 32). Empty: no link, the Releases page is off.
PANEL_GRAFANA_URL=
RELEASES_ADMIN_TOKEN=
