# Keep secrets and runtime data out of the build context and the image
# (docs/ops/security-setup.md). The server RSA key reaches the container as a
# compose secret at runtime, never through the image.
.env
.env.*
secrets/
.e2e/
.tools/
**/server_pkcs1.key
data/
teamgramd/logs/
# The GeoIP database: mounted into authsession at runtime, ~130 MB.
geoip/
# Not needed to build (build.sh does not read git metadata); ~100 MB of context.
.git/
