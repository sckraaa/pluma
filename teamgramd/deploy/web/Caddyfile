# The web client on a server (docker-compose.web.yaml, docs/ops/deployment.md):
# TLS certificates from Let's Encrypt, the site of the pluma-web image in /srv,
# and its MTProto WebSocket /apiws to the gateway's PROXY protocol listener,
# so that the gateway counts every web client by its own address. The other
# names of the site serve the landing page: the static files of pluma-site,
# releases under /pluma-site (PLUMA_SITE_DIR on the host), the live one behind the
# relative symlink /pluma-site/current.

{$PLUMA_WEB_DOMAIN} {
	handle /apiws {
		reverse_proxy gnetway:11444 {
			transport http {
				proxy_protocol v1
			}
		}
	}
	handle {
		root * /srv
		encode zstd gzip
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}

{$PLUMA_SITE_DOMAINS} {
	# The iPhone app from the site (docker-compose.iosinstall.yaml): the
	# profile, the device's answer, the install link and the IPA, and CI's
	# uploads of builds. Without that service these answer 502.
	handle /ios/adhoc/* {
		reverse_proxy iosinstall:9098
	}

	# A collection of the catalog from Telegram, from the collector in a tab
	# of Telegram Web K (docker-compose.catalog.yaml, docs/ops/catalog.md).
	# Without that service, which runs only during a collection, it answers
	# 502.
	handle /collect/* {
		reverse_proxy catalog-receiver:9099
	}

	# The public progress of the site (its "how much of Telegram" block): the
	# api-coverage.json of the deployed version, so every update shows at once.
	handle /progress.json {
		rewrite * /api-coverage.json
		root * /pluma-progress
		header Cache-Control "no-cache"
		file_server
	}

	root * /pluma-site/current
	encode zstd gzip

	# The device addresses open the same page; its script picks the card by the
	# address. /pero and /app answer without a redirect to the address with a slash.
	@devices path /iphone /ipad /android /mac /windows /linux /web
	rewrite @devices /index.html
	rewrite /pero /pero/index.html
	rewrite /app /app/index.html
	# The iPhone app from the site (hidden; /ios/adhoc/ above sends the
	# device back here).
	rewrite /iphone/install /iphone/install/index.html
	# The English version: the same addresses under /en.
	@devicesEn path /en/iphone /en/ipad /en/android /en/mac /en/windows /en/linux /en/web
	rewrite @devicesEn /en/index.html
	rewrite /en/pero /en/pero/index.html

	# Files with a hash in their names never change; the pages are checked on
	# every visit.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@pages path / /index.html /pero/index.html /app/index.html /app/app.js /404.html /en/ /en/index.html /en/pero/index.html /iphone/install/*
	header @pages Cache-Control "no-cache"

	# No inline scripts or styles on the site: styles a script sets go through
	# the CSSOM, which the policy does not cover. No access log: the footer says
	# the page counts nobody.
	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "interest-cohort=(), camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	file_server
	handle_errors {
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
