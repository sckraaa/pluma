install -m 0755 @SCRIPT@ /usr/local/sbin/pluma-tunnel
ufw prepend deny in on plumaru comment 'Pluma tunnel to the Russian node'
systemctl daemon-reload
systemctl enable -q wg-quick@plumaru pluma-tunnel-ru-rules.service
systemctl restart wg-quick@plumaru
systemctl restart pluma-tunnel-ru-rules.service
iptables -t mangle -I FORWARD -o plumaru -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -I FORWARD -i plumaru -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -D FORWARD -o plumaru -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -D FORWARD -i plumaru -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
