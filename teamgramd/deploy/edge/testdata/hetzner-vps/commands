install -m 0755 @SCRIPT@ /usr/local/sbin/pluma-tunnel
ufw allow proto udp to 198.51.100.7 port 51820 comment 'Pluma tunnel'
systemctl daemon-reload
systemctl enable -q wg-quick@pluma pluma-tunnel-rules.service
systemctl restart wg-quick@pluma
systemctl restart pluma-tunnel-rules.service
iptables -t nat -I POSTROUTING -s 10.77.0.2 -o eth0 -j SNAT --to-source 198.51.100.7
iptables -t filter -I FORWARD -i pluma -o eth0 -j ACCEPT
iptables -t filter -I FORWARD -i eth0 -o pluma -m conntrack --ctstate ESTABLISHED,RELATED,DNAT -j ACCEPT
iptables -t mangle -I FORWARD -o pluma -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -I FORWARD -i pluma -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t nat -D POSTROUTING -s 10.77.0.2 -o eth0 -j SNAT --to-source 198.51.100.7
iptables -t filter -D FORWARD -i pluma -o eth0 -j ACCEPT
iptables -t filter -D FORWARD -i eth0 -o pluma -m conntrack --ctstate ESTABLISHED,RELATED,DNAT -j ACCEPT
iptables -t mangle -D FORWARD -o pluma -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
iptables -t mangle -D FORWARD -i pluma -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
