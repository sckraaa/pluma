# The owner's site behind the SNI split on 443 (a stand-in of the layout of
# the Russian node: TLS on 127.0.0.1:8443 with PROXY, a redirect on 80).
server {
    server_name site.test;

    location / {
        default_type text/plain;
        return 200 "owner site\n";
    }

    listen 127.0.0.1:8443 ssl proxy_protocol;
    set_real_ip_from 127.0.0.1;
    real_ip_header proxy_protocol;
    ssl_certificate /etc/ssl/owner-test/cert.pem;
    ssl_certificate_key /etc/ssl/owner-test/key.pem;
}

server {
    if ($host = site.test) {
        return 301 https://$host$request_uri;
    }

    listen 80;
    server_name site.test;
    return 404;
}
